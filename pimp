show_dname_fzf()
{
	#  synopsis:  shows recursive and interactive list of directories to play.

	local opt="$(_params_opt "$*")"
	local str="$(_params_str "$*")"

	if _exists_opt b "${opt}"
	then
		#  omits opt to resume "play" tonal sound at start of music playback.
		local opt="$(printf '%s' "${opt}" | tr -d b)"
	fi

	local dpath_music="${PIMP_DPATH_MUSIC}"
	local fzf_opt=
	local fzf_query="${str}"

	export PIMP_CALLED_VIA_DPATH_DISPLAY=  #  allows another function to determine whether
	                                       #  it was called via this specific function.

	if [ -n "${opt}" ]
	then
		local fzf_opt="-${opt}"
	fi

	set_terminal_title

	find -L "${dpath_music}" -type d | \
	cut -d '/' -f "$(print_cut_field_selection_number)" | sed '/^$/d' | sed '1i\
.
	' | sort -r | \
	"${_bin_fzf}" -i -s -m -e \
		--header 'pimp (dir)' \
		--header-first \
		--border rounded \
		--color fg+:16,bg+:10,hl:9,hl+:1,gutter:1 \
		--prompt '> ' \
		--algo v1 \
		--query "${fzf_query}" \
		--literal \
		--cycle \
		--tac \
		--layout reverse \
		--preview "pkill -x ${_bin_tts}; pimp app-speech ${fzf_opt} {}; pimp app-tone high ${fzf_opt}" \
		--preview-window 0% \
		--bind "enter:execute(pkill -x ${_bin_tts}; pimp app-rmpp; pimp play -ds ${fzf_opt} {}; pimp app-tone high ${fzf_opt})" \
		--bind "double-click:execute(pkill -x ${_bin_tts}; pimp app-rmpp; pimp play -ds ${fzf_opt} {}; pimp app-tone high ${fzf_opt})" \
		--bind "insert:execute-silent(pkill -x ${_bin_tts}; pimp app-tone ffgo ${fzf_opt})+execute(pimp file ${fzf_opt})+execute-silent(pimp app-tone ffbk ${fzf_opt})" \
		--bind "f5:execute-silent(pkill -x ${_bin_tts}; pimp app-tone ffgo ${fzf_opt})+execute(pimp file ${fzf_opt})+execute-silent(pimp app-tone ffbk ${fzf_opt})" \
		--bind "f6:execute(pkill -x ${_bin_tts}; pimp play ${fzf_opt}; pimp app-tone high ${fzf_opt})" \
		--bind "*:execute(pkill -x ${_bin_tts}; pimp play ${fzf_opt}; pimp app-tone high ${fzf_opt})" \
		--bind 'change:first' \
		--bind 'bspace:clear-query' \
		--bind 'home:first' \
		--bind 'end:last' \
		--bind "esc:execute(pkill -x ${_bin_tts})+abort" \
		--bind "tab:execute(pkill -x ${_bin_tts})+abort" \
		--bind "alt-q:execute(pkill -x ${_bin_tts})+abort" \
		--bind "ctrl-q:execute(pkill -x ${_bin_tts})+abort"
}

show_fpath_fzf()
{
	#  synopsis:  shows recursive and interactive list of files to play.

	local opt="$(_params_opt "$*")"
	local str="$(_params_str "$*")"

	if _exists_opt b "${opt}"
	then
		#  omits opt to resume "play" tonal sound at start of music playback.
		local opt="$(printf '%s' "${opt}" | tr -d b)"
	fi

	local cmd_pimp_quit='10_cmd_filter_quit'
	local cmd_pimp_refresh='20_cmd_filter_refresh'
	local cmd_pimp_resume_pback='30_cmd_resume_pback'
	local dpath_music="${PIMP_DPATH_MUSIC}"
	local fpath_state_plist="${PIMP_FPATH_STATE_PLIST}"
	local fzf_opt=
	local fzf_query="${str}"
	local i=0
	local int_modtime_plist_preloop="$(get_file_modtime "${fpath_state_plist}")"
	local int_modtime_plist_pstloop=

	if [ -n "${opt}" ]
	then
		local fzf_opt="-${opt}"
	fi

	set_terminal_title

	if ! set | grep -q '^PIMP_CALLED_VIA_DPATH_DISPLAY='
	then
		play_tonal_sound high "-${opt}"
	fi

	find -L "${dpath_music}" -type f | \
	cut -d '/' -f "$(print_cut_field_selection_number)" | sed '/^$/d' | sort -r | \
	"${_bin_fzf}" -i -s -m -e \
		--header 'pimp (file)' \
		--header-first \
		--border rounded \
		--color fg+:16,bg+:10,hl:9,hl+:1,gutter:1 \
		--prompt '> ' \
		--algo v1 \
		--query "${fzf_query}" \
		--literal \
		--cycle \
		--tac \
		--header-lines 0 \
		--layout reverse \
		--bind "backward-eof:execute-silent(pimp app-tone clsh ${fzf_opt})" \
		--bind "esc:become(printf '%s\n'    ${cmd_pimp_quit})+abort" \
		--bind "tab:become(printf '%s\n'    ${cmd_pimp_quit})+abort" \
		--bind "insert:become(printf '%s\n' ${cmd_pimp_quit})+abort" \
		--bind "alt-q:become(printf '%s\n'  ${cmd_pimp_quit})+abort" \
		--bind "ctrl-q:become(printf '%s\n' ${cmd_pimp_quit})+abort" \
		--bind "f5:become(printf '%s\n'     ${cmd_pimp_quit})+abort" \
		--bind "f6:become(printf '%s\n'     ${cmd_pimp_resume_pback})+abort" \
		--bind "f7:become(printf '%s\n'     ${cmd_pimp_refresh})+abort" \
		--bind "*:become(printf '%s\n'      ${cmd_pimp_resume_pback})+abort" \
		--bind 'enter:select-all+accept' \
		--bind 'double-click:select-all+accept' \
		--bind 'change:first' \
		--bind 'alt-bspace:clear-query' \
		--bind 'home:first' \
		--bind 'end:last' | ( \

		#  until `fzf` intuitively enables the processing of multi-line
		#  output, a while-read subshell, along with case and return
		#  statements, must be facilitated to mimic said program as it
		#  would normally behave (when handling single-line output).

		while read -r f
		do
			if [ ${i} -eq 0 ]
			then
				case "${f}" in
					"${cmd_pimp_quit}")
						return 10
						;;
					"${cmd_pimp_refresh}")
						return 20
						;;
					"${cmd_pimp_resume_pback}")
						return 30
						;;
					*)
						rm -f "${fpath_state_plist}"
						;;
				esac
			fi

			if [ ${i} -eq 200 ]  #  if 200th playlist item is processed (indicating playback delay).
			then
				play_tonal_sound ffpi "${fzf_opt}" &
			fi

			#  create absolute path and add to playlist file:
			printf '%s/%s\n' "${dpath_music}" "${f}" >> "${fpath_state_plist}"

			local i=$((i + 1))

			continue
		done

		return 0
	)

	case "$?" in
		10)
			return 0
			;;
		20)
			return 100
			;;
		30)
			play_music "${fzf_opt}"
			return 100
			;;
		*)
			local int_modtime_plist_pstloop="$(get_file_modtime "${fpath_state_plist}")"

			if [ "${int_modtime_plist_pstloop}" != "${int_modtime_plist_preloop}" ]
			then
				remove_playback_position_data
				play_music -s "${fzf_opt}"
				return 100
			else
				return 0
			fi
	esac
}

get_file_modtime()
{
	#  synopsis:  gets unix epoch modification timestamp of a file.

	local f="$1"
	local modtime=
	local sys="${_sys}"

	if ! [ -f "${f}" ]
	then
		printf 0
		return 1
	fi

	case "${sys}" in
		linux)
			local modtime="$(stat -c %Y "${f}")"
			printf '%s' "${modtime}"
			;;
		darwin|openbsd|*)
			local modtime="$(stat -f %m "${f}")"
			printf '%s' "${modtime}"
			;;
	esac

	return 0
}

play_music()
{
	#  synopsis:  plays contents of generated playlist file.

	local opt="$(_params_opt "$*")"
	local str="$(_params_str "$*")"
	local sys="${_sys}"

	if _enabled_debug
	then
		printf 'func play_music opt: %s<\n' "${opt}"
		printf 'func play_music str: %s<\n' "${str}"
		printf 'func play_music sys: %s<\n' "${sys}"
	else
		clear
	fi

	local dpath_confg="${PIMP_DPATH_CONFG}"
	local dpath_dname_fzf_selection=
	local dpath_music="${PIMP_DPATH_MUSIC}"
	local dpath_share="${PIMP_DPATH_SHARE}"
	local dpath_state="${PIMP_DPATH_STATE}"
	local dpath_state_pback="${PIMP_DPATH_STATE_PBACK}"

	local fpath_confg_pback_input="${dpath_confg}/input.conf"
	local fpath_share_script_pback_autosave="${dpath_share}/autosave.lua"
	local fpath_state_plist="${PIMP_FPATH_STATE_PLIST}"

	if _exists_opt d "${opt}" && [ -n "${str}" ]
	then
		#  create playlist file using show_dname_fzf selection.

		if [ -d "${dpath_music}/${str}" ]
		then
			local dpath_dname_fzf_selection="$(realpath "${dpath_music}/${str}")"
			find -L "${dpath_dname_fzf_selection}" -type f > "${fpath_state_plist}"
		else
			return 1
		fi
	fi

	if ! [ -f "${fpath_share_script_pback_autosave}" ]
	then
		if ! print_playback_position_autosave_script > "${fpath_share_script_pback_autosave}"
		then
			printf 'pimp: unable to create playback position auto-save script: %s\n' "${fpath_share_script_pback_autosave}" >&2
		fi
	fi

	if ! [ -f "${fpath_confg_pback_input}" ]
	then
		if ! touch "${fpath_confg_pback_input}"
		then
			printf 'pimp: unable to create playback input configuration file: %s\n' "${fpath_confg_pback_input}" >&2
		fi
	fi

	if [ -f "${fpath_state_plist}" ]
	then

		if _exists_opt s "${opt}"
		then
			#  shuffle playlist file content.
			sort -R "${fpath_state_plist}" -o "${fpath_state_plist}"
		fi

		case "${sys}" in
			darwin|linux)
				printf '%spimp: initiating the slap... (⌐■_■)%s\n' \
					"$(tput bold)" "$(tput sgr0)"
				;;
			*)
				printf '%spimp: initiating the slap...%s\n' \
					"$(tput bold)" "$(tput sgr0)"
				;;
		esac

		play_tonal_sound play "-${opt}"

		"${_bin_mus}" \
			--af-add=scaletempo=speed=both \
			--audio-pitch-correction=no \
			--display-tags= \
			--input-conf="${fpath_confg_pback_input}" \
			--loop-playlist=inf \
			--msg-level=all=no,term-msg=status,statusline=status,cplayer=error,ffmpeg=fatal,ffmpeg/demuxer=error \
			--no-audio-display \
			--no-video \
			--osd-level=0 \
			--playlist="${fpath_state_plist}" \
			--save-position-on-quit \
			--script="${fpath_share_script_pback_autosave}" \
			--term-playing-msg="\n\${filename}" \
			--term-status-msg="\n(\${playlist-pos-1}/\${playlist-count}) \${time-pos} / \${duration} (\${percent-pos}%) (x\${speed}) \${?loop-file==inf:+LF }\${?mute==yes:+M }\${?pause==yes:(Paused)}" \
			--term-title="pimp -- \${filename}" \
			--vo=null \
			--volume=100 \
			--volume-max=100 \
			--video=no \
			--watch-later-directory="${dpath_state_pback}" \
			--watch-later-options=volume,speed,pause,loop-file,start \
			--watch-later-options-remove=mute,ab-loop

		set_terminal_title
	else
		printf 'pimp: playlist file not found: %s\n' "${fpath_state_plist}" >&2
		return 2
	fi
}

play_speech()
{
	#  synopsis:  plays speech for auditory navigation.

	local opt="$(_params_opt "$*")"
	local str="$(_params_str "$*")"
	local sys="${_sys}"

	if _exists_opt Q "${opt}"
	then
		return 0
	fi

	cmd_tts()
	{
		case "${sys}" in
			darwin)
				if command -v say >/dev/null 2>&1
				then
					say -v fred -r 350 "$@"
				else
					return 1
				fi
				;;
			*)
				if command -v "${_bin_tts}" >/dev/null 2>&1
				then
					"${_bin_tts}" "$@"
				else
					return 1
				fi
				;;
		esac
	}

	str_tts()
	{
		#  removes directory path forward slashes for tts
		printf '%s' "${str}" | sed 's/\//, /g'
	}

	case "${sys}" in
		darwin)
			str_tts | cmd_tts || return 1
			;;
		linux)
			str_tts | cmd_tts -a 0100 -s 300 || return 1
			;;
		openbsd|*)
			str_tts | cmd_tts -a 0100 -s 235 || return 1
			;;
	esac

	return 0
}

play_tonal_sound()
{
	#  synopsis:  generates and plays tonal sound effects for auditory navigation.

	local opt="$(_params_opt "$*")"
	local str="$(_params_str "$*")"
	local sys="${_sys}"

	if _enabled_debug
	then
		printf 'func play_tonal_sound opt: %s<\n' "${opt}"
		printf 'func play_tonal_sound str: %s<\n' "${str}"
	fi

	if _exists_opt Q "${opt}"
	then
		return 0
	fi

	local dpath_cache="${PIMP_DPATH_CACHE}"
	local dpath_share_sound="${PIMP_DPATH_SHARE_SOUND}"
	local fpath_share_sound=

	cmd_sound_play()
	{
		play -q "$1"
	}

	case "${str}" in
		boot)
			#  pimp boot / initialization (for stereos)
			local fpath_share_sound="${dpath_share_sound}/boot.wav"

			if ! [ -f "${fpath_share_sound}" ] && command -v "${_bin_snd}" >/dev/null 2>&1
			then
				"${_bin_snd}" -n "${dpath_cache}/1.wav" \
					synth sine 1000 trim 0 0.15 gain -20 \
					pad 0 0.001 \
					gain 5

				"${_bin_snd}" -n "${dpath_cache}/2.wav" \
					synth sine 1500 trim 0 0.15 gain -20 \
					pad 0 0.001 \
					gain 5

				"${_bin_snd}" -n "${dpath_cache}/3.wav" \
					synth sine 2000 trim 0 0.15 gain -20 \
					pad 0 1 \
					gain 5

				"${_bin_snd}" \
					"${dpath_cache}/1.wav" \
					"${dpath_cache}/2.wav" \
					"${dpath_cache}/3.wav" \
					"${fpath_share_sound}"

				rm -f "${dpath_cache}/*.wav"
			fi

			cmd_sound_play "${fpath_share_sound}"
			;;
		clsh)
			#  text (search box cleared)
			local fpath_share_sound="${dpath_share_sound}/clsh.wav"

			if ! [ -f "${fpath_share_sound}" ] && command -v "${_bin_snd}" >/dev/null 2>&1
			then
				"${_bin_snd}" -n "${fpath_share_sound}" \
					synth sine 0200 trim 0 0.05 gain -20 \
					pad 0 0.1
			fi

			cmd_sound_play "${fpath_share_sound}" &
			;;
		ffpi)
			#  show_fpath_fzf playlist initialization
			local fpath_share_sound="${dpath_share_sound}/ffpi.wav"

			if ! [ -f "${fpath_share_sound}" ] && command -v "${_bin_snd}" >/dev/null 2>&1
			then
				"${_bin_snd}" -n "${dpath_cache}/1.wav" \
					synth sine 0500 trim 0 0.05 gain -20 \
					pad 0 0.05

				"${_bin_snd}" -n "${dpath_cache}/2.wav" \
					synth sine 0500 trim 0 0.05 gain -20 \
					pad 0 0.05

				"${_bin_snd}" -n "${dpath_cache}/3.wav" \
					synth sine 0500 trim 0 0.05 gain -20 \
					pad 0 1

				"${_bin_snd}" \
					"${dpath_cache}/1.wav" \
					"${dpath_cache}/2.wav" \
					"${dpath_cache}/3.wav" \
					"${fpath_share_sound}"

				rm -f "${dpath_cache}/*.wav"
			fi

			cmd_sound_play "${fpath_share_sound}" &
			;;
		ffbk)
			#  fuzzy finder (return to show_dname_fzf)
			local fpath_share_sound="${dpath_share_sound}/ffbk.wav"

			if ! [ -f "${fpath_share_sound}" ] && command -v "${_bin_snd}" >/dev/null 2>&1
			then
				"${_bin_snd}" -n "${dpath_cache}/1.wav" \
					synth sine 1500 trim 0 0.05 gain -30 \
					pad 0 0.1

				"${_bin_snd}" -n "${dpath_cache}/2.wav" \
					synth sine 1400 trim 0 0.05 gain -30 \
					pad 0 0.1

				"${_bin_snd}" \
					"${dpath_cache}/1.wav" \
					"${dpath_cache}/2.wav" \
					"${fpath_share_sound}"

				rm -f "${dpath_cache}/*.wav"
			fi

			cmd_sound_play "${fpath_share_sound}" &
			;;
		ffgo)
			#  fuzzy finder (change to show_fpath_fzf)
			local fpath_share_sound="${dpath_share_sound}/ffgo.wav"

			if ! [ -f "${fpath_share_sound}" ] && command -v "${_bin_snd}" >/dev/null 2>&1
			then
				"${_bin_snd}" -n "${dpath_cache}/1.wav" \
					synth sine 1500 trim 0 0.05 gain -30 \
					pad 0 0.1

				"${_bin_snd}" -n "${dpath_cache}/2.wav" \
					synth sine 2000 trim 0 0.05 gain -30 \
					pad 0 0.1

				"${_bin_snd}" \
					"${dpath_cache}/1.wav" \
					"${dpath_cache}/2.wav" \
					"${fpath_share_sound}"

				rm -f "${dpath_cache}/*.wav"
			fi

			cmd_sound_play "${fpath_share_sound}" &
			;;
		high)
			#  item (highlighted)
			local fpath_share_sound="${dpath_share_sound}/high.wav"

			if ! [ -f "${fpath_share_sound}" ] && command -v "${_bin_snd}" >/dev/null 2>&1
			then
				"${_bin_snd}" -n "${fpath_share_sound}" \
					synth sine 2000 trim 0 0.05 gain -30 \
					pad 0 0.1
			fi

			cmd_sound_play "${fpath_share_sound}"
			;;
		play)
			#  item (selected for music playback)
			if _exists_opt b "${opt}"
			then
				return 0
			fi

			local fpath_share_sound="${dpath_share_sound}/play.wav"

			if ! [ -f "${fpath_share_sound}" ] && command -v "${_bin_snd}" >/dev/null 2>&1
			then
				"${_bin_snd}" -n "${fpath_share_sound}" \
					synth sine 1000 trim 0 0.05 gain -30 \
					pad 0 0.1
			fi

			cmd_sound_play "${fpath_share_sound}"
			;;
	esac

	return 0
}

print_cut_field_selection_number()
{
	#  description:
	#
	#  posix solution to count number of directory levels in
	#  $PIMP_DPATH_MUSIC; facilitates removal of $PIMP_DPATH_MUSIC
	#  from fzf lists via `cut`.

	local dpath_music="${PIMP_DPATH_MUSIC}"
	local int_dpath_sections="$(( $(printf '%s' "${dpath_music}" | sed 's/\// /g' | wc -w) + 2 ))"

	printf '%s-' "${int_dpath_sections}" && \
		return 0
}

print_playback_position_autosave_script()
{
	cat <<EOF

-- autosave.lua
-- ------------
--
-- periodically saves watch_later data during mpv playback.
-- accounts for periodic write synchronization on raspberry pi.

os        = require 'os'
mp        = require 'mp'
mp_opt    = require 'mp.options'
timer_opt = {save_period = 15} -- seconds per mpv watch_later data save.
raspi     = false

function platform()

	-- gets running platform / os.

	local out = io.popen('uname -s')
	local sys = out:read '*line'

	io.close(out)
	return sys:lower()
end

function raspi_write_sync()

	-- synchronizes mpv watch_later data to raspberry pi storage device.

	local f = nil

	if raspi == true then
		os.execute('sync')
		return true
	end

	-- raspberry pi os:
	if platform() == 'linux' then
		f = io.open('/sys/firmware/devicetree/base/model', 'r')
	end

	if f ~= nil then
		str = f:read '*a'
		io.close(f)
	else
		return false
	end

	if string.match(str, '^Raspberry Pi') then
		raspi = true
		os.execute('sync')
		return true
	else
		return false
	end
end

function add_wl()
	mp.commandv('write-watch-later-config')
	raspi_write_sync()
end

function del_wl(data)
	if data.reason == 'eof' or data.reason == 'stop' then
		local playlist = mp.get_property_native('playlist')

		for i, entry in pairs(playlist) do
			if entry.id == data.playlist_entry_id then
				mp.commandv('delete-watch-later-config', entry.filename)
				raspi_write_sync()
			end
		end
	end
end

mp_opt.read_options(timer_opt)
save_period_timer = mp.add_periodic_timer(timer_opt.save_period, add_wl)

mp.register_event('file-loaded', add_wl)
mp.register_event('start-file',  add_wl)
mp.register_event('end-file',    del_wl)
EOF

	return 0
}

