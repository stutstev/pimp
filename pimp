_exists_app_dir_tree()
{
	#  synopsis:  creates application file structure.

	local dpath_cache="${PIMP_DPATH_CACHE}"
	local dpath_confg="${PIMP_DPATH_CONFG}"
	local dpath_music="${PIMP_DPATH_MUSIC}"
	local dpath_share="${PIMP_DPATH_SHARE}"
	local dpath_share_sound="${PIMP_DPATH_SHARE_SOUND}"
	local dpath_state="${PIMP_DPATH_STATE}"
	local dpath_state_pback="${PIMP_DPATH_STATE_PBACK}"

	if ! [ -d "${dpath_music}" ]
	then
		printf 'pimp: music directory not found: %s\n' "${dpath_music}" >&2
		return 2
	fi

	if ! [ -d "${dpath_cache}" ]
	then
		if ! mkdir -p "${dpath_cache}"
		then
			printf 'pimp: unable to create cache directory: %s\n' "${dpath_cache}" >&2
		fi
	fi

	if ! [ -d "${dpath_confg}" ]
	then
		if ! mkdir -p "${dpath_confg}"
		then
			printf 'pimp: unable to create configuration directory: %s\n' "${dpath_confg}" >&2
		fi
	fi

	if ! [ -d "${dpath_share}" ]
	then
		if ! mkdir -p "${dpath_share}"
		then
			printf 'pimp: unable to create share directory: %s\n' "${dpath_share}" >&2
			return 2
		fi
	fi

	if ! [ -d "${dpath_share_sound}" ]
	then
		if ! mkdir -p "${dpath_share_sound}"
		then
			printf 'pimp: unable to create sound effect directory: %s\n' "${dpath_share_sound}" >&2
			return 2
		fi
	fi

	if ! [ -d "${dpath_state}" ]
	then
		if ! mkdir -p "${dpath_state}"
		then
			printf 'pimp: unable to create state directory: %s\n' "${dpath_state}" >&2
			return 2
		fi
	fi

	if ! [ -d "${dpath_state_pback}" ]
	then
		if ! mkdir -p "${dpath_state_pback}"
		then
			printf 'pimp: unable to create playback position directory: %s\n' "${dpath_state_pback}" >&2
		fi
	fi

	return 0
}

_exists_opt()
{
	#  synopsis:  confirms existence of parameter option passed from function call.
	#
	#  usage:
	#    _exists_opt a "${string}"
	#        ^
	#        |
	#        |
	#        "a" as in an "-a" option when calling a function.
	#
	#  below, a string / $2 ("a") must match specified option / $1 ("-a").

	if printf '%s' "$2" | grep -q "$1"
	then
		return 0  #  true
	else
		return 1  #  false
	fi
}

_exists_depends()
{
	#  synopsis:  ensures program dependencies exist in $PATH.

	local err=0
	local i=               #     last program will not process without
	local programs="$* -"  #  <- placeholder at end of string.

	printf '%s' "${programs}" | tr '[:space:]' '\n' | ( \

		while read -r i
		do
			if ! command -v "${i}" >/dev/null 2>&1
			then
				if [ ${err} -eq 0 ]
				then
					printf 'pimp: prerequisite programs not found:\n' >&2
					local err=1
				fi

				printf '%s\n' " - ${i}" >&2
			fi
		done

		return "${err}"
	)

	return $?
}

_params_opt()
{
	printf '%s' "$*"          | \
	grep -o '\-[a-zA-Z0-9]*'  | \
	sed 's/-//g'              | \
	tr -d '\n'
}

_params_str()
{
	printf '%s' "$*"          | \
	sed 's/\-[a-zA-Z0-9]*//g' | \
	sed 's/^[[:space:]]*//g'  | \
	sed 's/[[:space:]]*$//g'
}

if ! _exists_depends "${_depends_dire}"
then
	exit 2
fi

if ! _exists_depends "${_depends_optional}"
then
	printf '\npimp: continuing...\n' >&2
fi

if ! _exists_app_dir_tree
then
	exit 2
fi

if _enabled_debug
then
	printf 'init cmdline: %s<\n' "$*"
	printf 'init param: %s<\n' "${_params}"
fi

case "$1" in
	app-tone)
		play_tonal_sound "${_params}"
		exit $?
		;;
	app-speech)
		play_speech "${_params}"
		exit $?
		;;
	app-rmpp)
		remove_playback_position_data
		exit $?
		;;
	d|dir)
		show_dname_fzf "${_params}"
		exit $?
		;;
	f|file)
		while :
		do
			show_fpath_fzf "${_params}"

			case "$?" in
