remove_playback_position_data()
{
	#  synopsis:  deletes preexisting mpv watch_later / playback position data.

	set -u

	local dpath_state_pback="${PIMP_DPATH_STATE_PBACK}"

	if rm -f "${dpath_state_pback}"/* >/dev/null 2>&1
	then
		return 0
	else
		printf 'pimp: playback position data stored within "%s" could not be deleted.\n' \
			"${dpath_state_pback}" >&2
		return 1
	fi
}

